#!/usr/bin/env bash
set +x
set -euo pipefail
ulimit -c 0

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if ! family="$(
  sops decrypt \
    --extract '["cloudflare_family_emails"]' \
    --output-type json \
    secrets.yaml 2>/dev/null |
    jq -ce '
      if type != "array" or length == 0 then error("invalid audience")
      elif all(.[];
        type == "string"
        and length > 0
        and (test("[[:space:][:cntrl:]]") | not)
      ) then .
      else error("invalid audience")
      end
    ' 2>/dev/null
)"; then
  printf '%s\n' "unable to decrypt or validate Cloudflare family audience" >&2
  exit 1
fi

mask() {
  local value="$1"
  value="${value//'%'/'%25'}"
  value="${value//$'\r'/'%0D'}"
  value="${value//$'\n'/'%0A'}"
  printf '::add-mask::%s\n' "$value"
}

if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
  mask "$family"
  while IFS= read -r address; do
    mask "$address"
  done < <(jq -r '.[]' <<< "$family")
fi

export TF_VAR_family_emails="$family"
unset family SOPS_AGE_KEY SOPS_AGE_KEY_FILE SOPS_AGE_KEY_CMD
unset TF_LOG TF_LOG_PATH TF_LOG_CORE TF_LOG_PROVIDER

if [[ "${1:-}" == --check-secrets ]]; then
  exit 0
fi

exec tofu "$@"
