{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "workspaceColors": {
    "notificationBadgeColor": null,
    "selectionColor": null
  },
  "commands": [
    {
      "name": "mbp-m2",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "mbp-m2",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "btop",
                    "command": "exec zmx attach cmux-btop btop",
                    "focus": true
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "amp",
                    "command": "exec zmx attach cmux-amp amp --no-tui --remote-control"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "lgo-z2e",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "lgo-z2e",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "btop",
                    "command": "exec ssh -t lgo-z2e \"zmx attach cmux-btop btop\"",
                    "focus": true
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "amp",
                    "command": "exec ssh -t lgo-z2e \"zmx attach cmux-amp amp --no-tui --remote-control\""
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "htz-relay",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "htz-relay",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "btop",
                    "command": "exec ssh -t htz-relay \"zmx attach cmux-btop btop\"",
                    "focus": true
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "amp",
                    "command": "exec ssh -t htz-relay \"zmx attach cmux-amp amp --no-tui --remote-control\""
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "gru-relay",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "gru-relay",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "btop",
                    "command": "exec ssh -t gru-relay \"zmx attach cmux-btop btop\"",
                    "focus": true
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "amp",
                    "command": "exec ssh -t gru-relay \"zmx attach cmux-amp amp --no-tui --remote-control\""
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
