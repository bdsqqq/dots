{
	"tagOwners": {
		// Service hosts use a device identity rather than a person's identity.
		"tag:service-host": ["autogroup:owner"],
		"tag:exit-node":    ["autogroup:owner", "tag:service-host"],
	},

	"autoApprovers": {
		"routes": {
			"0.0.0.0/0": ["tag:exit-node"],
			"::/0":      ["tag:exit-node"],
		},
		"services": {
			"svc:apps": ["tag:service-host"],
		},
	},

	"grants": [
		// The owner can reach their devices and use exit nodes.
		{
			"src": ["autogroup:owner"],
			"dst": ["autogroup:owner", "autogroup:internet"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:owner"],
			"dst": ["tag:service-host"],
			"ip":  ["*"],
		},

		// Start the portable app directory with an owner-only canary.
		{
			"src": ["autogroup:owner"],
			"dst": ["svc:apps"],
			"ip":  ["443"],
		},

		// Invited members can reach their own devices, but not each other's.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		// Keep administrative access after a host adopts the service identity.
		{
			"action": "check",
			"src":    ["autogroup:owner"],
			"dst":    ["tag:service-host"],
			"users":  ["autogroup:nonroot", "root"],
		},

		// Members can only Tailscale SSH into their own devices.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
