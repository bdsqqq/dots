{
	"tagOwners": {
		// Service hosts use a device identity rather than a person's identity.
		"tag:service-host": ["autogroup:owner"],
		"tag:ssh-accept": ["autogroup:owner"],
		"tag:depot-runner": ["autogroup:owner"],
		"tag:cf-ingress":   ["autogroup:owner"],
		"tag:cf-files-ingress": ["autogroup:owner"],
		"tag:cf-t3-ingress": ["autogroup:owner"],
	},
	"hosts": {
		"mbp-m2": "100.87.59.1",
	},

	"autoApprovers": {
		"exitNode": ["tag:service-host"],
		"services": {
			"svc:apps":       ["tag:service-host"],
			"svc:fleet-mesh": ["tag:service-host"],
			"svc:html-stuff": ["tag:service-host"],
			"svc:hue":        ["tag:service-host"],
			"svc:files":      ["tag:service-host"],
			"svc:photos":     ["tag:service-host"],
			"svc:t3":         ["tag:service-host"],
		},
	},

	"grants": [
		// The owner can reach their devices and use exit nodes.
		{
			"src": ["autogroup:owner"],
			"dst": ["autogroup:owner", "autogroup:internet"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:owner"],
			"dst": ["tag:service-host", "tag:ssh-accept"],
			"ip":  ["*"],
		},
		// Selected personal devices retain their owner-device reachability after
		// adopting the identity used to exempt them from SSH check mode.
		{
			"src": ["tag:ssh-accept"],
			"dst": ["autogroup:owner", "tag:service-host", "tag:ssh-accept", "autogroup:internet"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:ssh-accept"],
			"dst": ["svc:apps", "svc:fleet-mesh", "svc:html-stuff", "svc:hue", "svc:files", "svc:photos", "svc:t3"],
			"ip":  ["443"],
		},
		// Service hosts fetch manifests and synchronize app data from owner devices.
		{
			"src": ["tag:service-host"],
			"dst": ["autogroup:owner", "tag:service-host", "tag:ssh-accept"],
			"ip":  ["5252", "22000"],
		},

		// Portable services begin as owner-only canaries.
		{
			"src": ["autogroup:owner"],
			"dst": ["svc:apps", "svc:fleet-mesh", "svc:html-stuff", "svc:hue", "svc:files", "svc:photos", "svc:t3"],
			"ip":  ["443"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["svc:photos"],
			"ip":  ["443"],
		},
		// Cloudflare connectors can reach only explicitly public-facing apps.
		{
			"src": ["tag:cf-ingress"],
			"dst": ["svc:html-stuff", "svc:photos"],
			"ip":  ["443"],
		},
		{
			"src": ["tag:cf-files-ingress"],
			"dst": ["svc:files"],
			"ip":  ["443"],
		},
		{
			"src": ["tag:cf-t3-ingress"],
			"dst": ["mbp-m2"],
			"ip":  ["8443"],
		},

		// Invited members can reach their own devices, but not each other's.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
	],

	"tests": [
		{
			"src":    "tag:cf-ingress",
			"accept": ["svc:html-stuff:443", "svc:photos:443"],
			"deny":   ["svc:apps:443", "svc:fleet-mesh:443", "svc:files:443", "svc:hue:443", "svc:t3:443"],
		},
		{
			"src":    "tag:cf-files-ingress",
			"accept": ["svc:files:443"],
			"deny":   ["svc:apps:443", "svc:fleet-mesh:443", "svc:html-stuff:443", "svc:hue:443", "svc:photos:443", "svc:t3:443"],
		},
		{
			"src":    "tag:cf-t3-ingress",
			"accept": ["mbp-m2:8443"],
			"deny":   ["svc:apps:443", "svc:fleet-mesh:443", "svc:files:443", "svc:html-stuff:443", "svc:hue:443", "svc:photos:443"],
		},
	],

	"ssh": [
		// These explicitly tagged devices permit unattended owner SSH. Other
		// personal devices continue through the self-device check rule below.
		{
			"action": "accept",
			"src":    ["autogroup:owner"],
			"dst":    ["tag:ssh-accept"],
			"users":  ["bdsqqq", "root"],
		},

		// Keep administrative access after a host adopts the service identity.
		{
			"action": "check",
			"src":    ["autogroup:owner"],
			"dst":    ["tag:service-host"],
			"users":  ["autogroup:nonroot", "root"],
		},

		// Members can only Tailscale SSH into their own devices.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
