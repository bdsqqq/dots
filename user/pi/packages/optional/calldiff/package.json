{
  "name": "@bds_pi/calldiff",
  "version": "0.4.1",
  "private": true,
  "description": "Local callback-aware fork of calldiff (22 languages)",
  "license": "MIT",
  "author": "Tanishq Kancharla; callback fork by bdsqqq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/calldiff.git"
  },
  "bin": {
    "pi-calldiff": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "incur": "0.4.26",
    "picocolors": "1.1.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "tree-sitter-typescript>tree-sitter": "$tree-sitter"
    }
  }
}
