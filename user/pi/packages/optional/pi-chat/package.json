{
	"name": "@bds_pi/pi-chat",
	"version": "0.1.0",
	"private": true,
	"description": "Multi-service chat bridge extension for pi",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"chat",
		"bridge",
		"telegram",
		"discord",
		"extension"
	],
	"license": "Apache-2.0",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@earendil-works/gondolin": "0.7.0",
		"discord.js": "14.26.3",
		"remend": "1.3.0",
		"ws": "8.20.0"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit && pnpm run test",
