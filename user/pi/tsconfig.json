{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022"],
    "allowJs": false,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "module": "preserve",
    "noEmit": true,
    "types": ["node", "vitest/importMeta"],
    "paths": {
      "@bds_pi/pi-memory": ["./packages/core/agent-memory/index.ts"],
      "@bds_pi/pi-memory/catalog": ["./packages/core/agent-memory/catalog.ts"],
      "@bds_pi/*": [
        "./packages/core/*/index.ts",
        "./packages/extensions/*/index.ts"
      ],
      "@/*": ["./*"]
    }
  }
}
