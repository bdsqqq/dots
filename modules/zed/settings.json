// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  "current_line_highlight": "gutter",
  "ui_font_family": ".SystemUIFont",
  "redact_private_values": true,
  "icon_theme": "Zed (Default)",
  "session": {
    "trust_all_worktrees": false
  },
  "close_on_file_delete": true,
  "minimum_split_diff_width": 100.0,
  "which_key": {
    "delay_ms": 0,
    "enabled": true
  },
  "document_symbols": "on",
  "semantic_tokens": "combined",
  "proxy": "",
  "diff_view_style": "unified",
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    }
  },
  "context_servers": {},
  "autosave": "on_focus_change",
  "document_folding_ranges": "on",
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
    "mode": "eager"
  },
  "git_panel": {
    "tree_view": true,
    "button": false,
    "dock": "right"
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "auto_update_extensions": {
    "vesper": false
  },
  "show_edit_predictions": true,
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Vesper_test"
  },
  "buffer_font_size": 14,
  "buffer_font_family": "Berkeley Mono",
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "gutter": {
    "line_numbers": false,
    "runnables": false,
    "breakpoints": false,
    "min_line_number_digits": 3,
    "folds": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": false,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50
  },
  "project_panel": {
    "sort_mode": "mixed",
    "hide_root": false,
    "git_status_indicator": false,
    "bold_folder_labels": false,
    "auto_fold_dirs": false,
    "indent_size": 16.0,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "button": true,
    "dock": "right"
  },
  "debugger": {
    "button": false
  },
  "agent": {
    "terminal_init_command": "pi",
    "auto_compact": {
      "enabled": false
    },
    "enable_feedback": false,
    "single_file_review": true,
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-latest"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-latest"
    },
    "enabled": true,
    "button": false,
    "dock": "left",
    "default_width": 640,
    "default_height": 640.0
  },
  "terminal": {
    "button": false,
    "dock": "bottom",
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": [
            ["cva\\(([^)]*)\\)", "[\"'`]?([^\"'`]+)[\"'`]?"],
            ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
            ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
          ]
        }
      }
    }
  },
  "languages": {
    "TSX": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "format_on_save": "on"
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "format_on_save": "on"
    }
  }
}
