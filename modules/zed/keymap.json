    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-;": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-r": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
