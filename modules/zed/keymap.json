      "cmd-r n": "editor::Rename",
      "cmd-g d": "editor::GoToDefinition",
      "cmd-g t": "editor::GoToTypeDefinition"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-:": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
