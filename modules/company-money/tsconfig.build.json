  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "sourceMap": true
  },
  "exclude": ["**/*.test.ts", "**/test-fixtures.ts", "dist", "node_modules"]
}
