{
  "name": "company-money",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "company-money": "./dist/company-money-bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/company-money-public.d.ts",
      "import": "./dist/company-money-public.js"
    },
