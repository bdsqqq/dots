+import { truncateToWidth, visibleWidth } from "../utils.js";
+/**
+ * Reserves a stable marker column while the child owns wrapping and formatting.
+ */
+export class MarkerColumn {
+    marker;
+    continuationMarker;
+    child;
+    gap;
+    constructor(marker, child, options = {}) {
+        this.marker = marker;
+        this.continuationMarker = options.continuationMarker ?? "";
+        this.child = child;
+        this.gap = Math.max(0, Math.floor(options.gap ?? 1));
+    }
+    setMarker(marker, continuationMarker = this.continuationMarker) {
+        this.marker = marker;
+        this.continuationMarker = continuationMarker;
+    }
+    setChild(child) {
+        this.child = child;
+    }
+    render(width) {
+        const safeWidth = Math.max(0, Math.floor(width));
+        if (safeWidth === 0)
+            return [];
+        const columnWidth = Math.min(safeWidth, Math.max(visibleWidth(this.marker), visibleWidth(this.continuationMarker)));
+        const gapWidth = Math.min(this.gap, Math.max(0, safeWidth - columnWidth));
+        const bodyWidth = safeWidth - columnWidth - gapWidth;
+        const prefix = (value) => {
+            const fitted = truncateToWidth(value, columnWidth, "");
+            return `${fitted}${" ".repeat(columnWidth - visibleWidth(fitted))}${" ".repeat(gapWidth)}`;
+        };
+        if (bodyWidth <= 0)
+            return [prefix(this.marker)];
+        const lines = this.child.render(bodyWidth);
+        if (lines.length === 0)
+            return [prefix(this.marker)];
+        return lines.map((line, index) => truncateToWidth(`${prefix(index === 0 ? this.marker : this.continuationMarker)}${line}`, safeWidth, ""));
+    }
+    invalidate() {
+        this.child.invalidate();
+    }
+}
