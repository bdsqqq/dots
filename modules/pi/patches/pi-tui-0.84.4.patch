+import { dispatchMouseEvent } from "../tui.js";
+import { truncateToWidth, visibleWidth } from "../utils.js";
+const HOVER_GLYPHS = new Map([
+    ["●", "◉"],
+    ["✓", "✔"],
+    ["✕", "✖"],
+    ["│", "┃"],
+    ["├", "┣"],
+    ["╰", "┗"],
+    ["─", "━"],
+    ["⋮", "⋮"],
+]);
+function hoverMarker(marker) {
+    return marker.replace(/[●✓✕│├╰─⋮]/gu, (glyph) => HOVER_GLYPHS.get(glyph) ?? glyph);
+}
+/**
+ * Reserves a stable marker column while the child owns wrapping and formatting.
+ */
+export class MarkerColumn {
+    marker;
+    continuationMarker;
+    footerMarker;
+    child;
+    gap;
+    onGutterClick;
+    isGutterInteractive;
+    renderedColumnWidth = 0;
+    renderedBodyHeight = 0;
+    renderedBodyOffset = 0;
+    renderedBodyWidth = 0;
+    renderedChildHeight = 0;
+    hovered = false;
+    constructor(marker, child, options = {}) {
+        this.marker = marker;
+        this.continuationMarker = options.continuationMarker ?? "";
+        this.footerMarker = options.footerMarker;
+        this.child = child;
+        this.gap = Math.max(0, Math.floor(options.gap ?? 1));
+        this.onGutterClick = options.onGutterClick;
+        this.isGutterInteractive = options.isGutterInteractive ?? (() => true);
+    }
+    setMarker(marker, continuationMarker = this.continuationMarker) {
+        this.marker = marker;
+        this.continuationMarker = continuationMarker;
+    }
+    setFooterMarker(footerMarker) {
+        this.footerMarker = footerMarker;
+    }
+    setChild(child) {
+        this.child = child;
+    }
+    render(width) {
+        const safeWidth = Math.max(0, Math.floor(width));
+        if (safeWidth === 0) {
+            this.renderedColumnWidth = 0;
+            this.renderedBodyHeight = 0;
+            this.renderedBodyOffset = 0;
+            this.renderedBodyWidth = 0;
+            this.renderedChildHeight = 0;
+            return [];
+        }
+        const columnWidth = Math.min(safeWidth, Math.max(visibleWidth(this.marker), visibleWidth(this.continuationMarker)));
+        const gapWidth = Math.min(this.gap, Math.max(0, safeWidth - columnWidth));
+        const bodyWidth = safeWidth - columnWidth - gapWidth;
+        this.renderedColumnWidth = columnWidth;
+        this.renderedBodyOffset = columnWidth + gapWidth;
+        this.renderedBodyWidth = bodyWidth;
+        this.renderedChildHeight = 0;
+        const prefix = (value) => {
+            if (this.hovered)
+                value = hoverMarker(value);
+            const fitted = truncateToWidth(value, columnWidth, "");
+            return `${fitted}${" ".repeat(columnWidth - visibleWidth(fitted))}${" ".repeat(gapWidth)}`;
+        };
+        const withFooter = (lines) => {
+            if (this.footerMarker)
+                lines.push(truncateToWidth(this.hovered ? hoverMarker(this.footerMarker) : this.footerMarker, safeWidth, ""));
+            this.renderedBodyHeight = lines.length;
+            return lines;
+        };
+        if (bodyWidth <= 0)
+            return withFooter([prefix(this.marker)]);
+        const lines = this.child.render(bodyWidth);
+        if (this.hovered && (!this.onGutterClick || !this.isGutterInteractive()))
+            this.hovered = false;
+        this.renderedChildHeight = lines.length;
+        if (lines.length === 0)
+            return withFooter([prefix(this.marker)]);
+        return withFooter(lines.map((line, index) => truncateToWidth(`${prefix(index === 0 ? this.marker : this.continuationMarker)}${line}`, safeWidth, "")));
+    }
+    handleMouse(event) {
+        if (event.type === "leave") {
+            const changed = this.hovered;
+            this.hovered = false;
+            return changed ? { handled: true, render: true } : undefined;
+        }
+        const inBodyRow = event.y >= 0 && event.y < this.renderedBodyHeight;
+        const inGutter = event.x >= 0 && event.x < this.renderedColumnWidth;
+        if (event.type === "move") {
+            const hovered = Boolean(this.onGutterClick) && this.isGutterInteractive() && inBodyRow && inGutter;
+            const changed = hovered !== this.hovered;
+            this.hovered = hovered;
+            if (hovered || changed)
+                return { handled: true, render: changed };
+        }
+        if (this.onGutterClick &&
+            this.isGutterInteractive() &&
+            inBodyRow &&
+            inGutter &&
+            event.type === "click" &&
+            event.button === "left" &&
+            !event.shift &&
+            !event.alt &&
+            !event.ctrl) {
+            this.onGutterClick();
+            return { handled: true };
+        }
+        const childX = event.x - this.renderedBodyOffset;
+        if (!inBodyRow ||
+            event.y >= this.renderedChildHeight ||
+            childX < 0 ||
+            childX >= this.renderedBodyWidth) {
+            return undefined;
+        }
+        return dispatchMouseEvent(this.child, {
+            ...event,
+            x: childX,
+            width: this.renderedBodyWidth,
+            height: this.renderedChildHeight,
+        });
+    }
+    invalidate() {
+        this.child.invalidate();
+    }
