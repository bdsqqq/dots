{
  "defaultProvider": "claude-code",
  "extensions": [
    "!**/agent-memory/**"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "skills": [
    "~/.config/agents/skills"
  ],
  "themes": [
    "~/.pi/agent/extensions/editor/themes"
  ],
  "compaction": {
    "enabled": true
  },
  "lastChangelogVersion": "1.6.0",
  "defaultModel": "default",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "enableSkillCommands": false,
  "showHardwareCursor": true,
  "transport": "auto",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "no-tools",
  "theme": "unboxed-dark",
  "outputPad": 0,
  "showCacheMissNotices": true,
  "tuiMode": "regular",
  "fullscreenExitOutput": "resume-hint",
  "packages": [
    "git:github.com/bdsqqq/pi-claude-code@0665b571fe36e4faa894a57c20c2c0be047f3e11"
  ],
  "@bds_pi/session-recap": {
    "enabled": false
  }
}