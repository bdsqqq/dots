{
  "name": "@bds_pi/pi-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-service chat bridge extension for pi",
  "keywords": [
    "bridge",
    "chat",
    "discord",
    "extension",
    "pi",
    "pi-package",
    "telegram"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "biome check . && tsc --noEmit && pnpm run test",
    "format": "biome check --write .",
    "test": "cd ../../.. && vitest run packages/optional/pi-chat",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.7.0",
    "discord.js": "14.26.3",
    "remend": "1.3.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typebox": "catalog:",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
