{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "workspaceColors": {
    "notificationBadgeColor": null,
    "selectionColor": null
  },
  "commands": [
    {
      "name": "mbp-m2",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "mbp-m2",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "btop",
                "command": "exec zmx attach cmux-btop btop",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "lgo-z2e",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "lgo-z2e",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "btop",
                "command": "exec ssh -t lgo-z2e \"zmx attach cmux-btop btop\"",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "htz-relay",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "htz-relay",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "btop",
                "command": "exec ssh -t htz-relay \"zmx attach cmux-btop btop\"",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "gru-relay",
      "keywords": ["cmux-fleet"],
      "restart": "ignore",
      "workspace": {
        "name": "gru-relay",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "btop",
                "command": "exec ssh -t gru-relay \"zmx attach cmux-btop btop\"",
                "focus": true
              }
            ]
          }
        }
      }
    }
  ]
}
