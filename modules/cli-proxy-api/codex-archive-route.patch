diff --git a/internal/runtime/executor/codex_executor_auth.go b/internal/runtime/executor/codex_executor_auth.go
--- a/internal/runtime/executor/codex_executor_auth.go
+++ b/internal/runtime/executor/codex_executor_auth.go
@@ -467,6 +467,14 @@ func codexCreds(a *cliproxyauth.Auth) (apiKey, baseURL string) {
 	if a.Attributes != nil {
 		baseURL = a.Attributes["base_url"]
 	}
+	// OAuth files preserve editable fields in Metadata; unlike API-key configs,
+	// their synthesizer does not populate the base_url attribute for Codex.
+	// Honor that explicit route so a local recorder sees each upstream attempt.
+	if baseURL == "" && a.Metadata != nil {
+		if value, ok := a.Metadata["base_url"].(string); ok {
+			baseURL = strings.TrimSpace(value)
+		}
+	}
 	if codexUseSIWC(a) {
 		apiKey = codexSIWCAccessToken(a)
 		if strings.TrimSpace(baseURL) == "" {
@@ -474,6 +482,11 @@ func codexCreds(a *cliproxyauth.Auth) (apiKey, baseURL string) {
 		}
 		return
 	}
+	// A server-owned recorder is the default for newly enrolled OAuth accounts.
+	// SIWC/API billing above deliberately retains its own upstream semantics.
+	if baseURL == "" {
+		baseURL = strings.TrimSpace(os.Getenv("CLI_PROXY_API_CODEX_ARCHIVE_BASE_URL"))
+	}
 	if a.Attributes != nil {
 		apiKey = a.Attributes["api_key"]
 	}
diff --git a/internal/runtime/executor/codex_archive_route_test.go b/internal/runtime/executor/codex_archive_route_test.go
new file mode 100644
--- /dev/null
+++ b/internal/runtime/executor/codex_archive_route_test.go
@@ -0,0 +1,41 @@
+package executor
+
+import (
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestArchiveCodexCredsMetadataRoute(t *testing.T) {
+	t.Setenv("CLI_PROXY_API_CODEX_ARCHIVE_BASE_URL", "")
+	for _, tc := range []struct {
+		name string
+		auth *cliproxyauth.Auth
+		want string
+	}{
+		{"nil", nil, ""},
+		{"native-default", &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "fixture"}}, ""},
+		{"oauth-route", &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "fixture", "base_url": " http://127.0.0.1:18318/backend-api/codex "}}, "http://127.0.0.1:18318/backend-api/codex"},
+		{"attribute-precedence", &cliproxyauth.Auth{Attributes: map[string]string{"base_url": "https://explicit.example.test/v1"}, Metadata: map[string]any{"base_url": "http://127.0.0.1:18318"}}, "https://explicit.example.test/v1"},
+		{"invalid-metadata", &cliproxyauth.Auth{Metadata: map[string]any{"base_url": true}}, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, got := codexCreds(tc.auth)
+			if got != tc.want {
+				t.Fatalf("base URL = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestArchiveCodexCredsGlobalRoute(t *testing.T) {
+	t.Setenv("CLI_PROXY_API_CODEX_ARCHIVE_BASE_URL", "http://127.0.0.1:18318/backend-api/codex")
+	_, got := codexCreds(&cliproxyauth.Auth{Metadata: map[string]any{"access_token": "fixture"}})
+	if got != "http://127.0.0.1:18318/backend-api/codex" {
+		t.Fatalf("default OAuth route = %q", got)
+	}
+	_, got = codexCreds(&cliproxyauth.Auth{Metadata: map[string]any{"use_siwc": true}})
+	if got != defaultOpenAISIWCBaseURL {
+		t.Fatalf("SIWC route was replaced: %q", got)
+	}
+}
